{
  "name": "authn-authz-learning",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @auth-learning/web --filter @auth-learning/api dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "db:generate": "pnpm --filter @auth-learning/api db:generate",
    "db:migrate": "pnpm --filter @auth-learning/api db:migrate",
    "bootstrap:openfga": "tsx scripts/bootstrap-openfga.ts",
    "seed:editor": "tsx scripts/seed-zitadel-editor.ts",
    "test:openfga": "pnpm --filter @auth-learning/api test:openfga"
  },
  "devDependencies": {
    "@openfga/sdk": "^0.8.0",
    "dotenv": "^16.5.0",
    "jose": "^6.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
