# Docker Compose
POSTGRES_USER=app
POSTGRES_PASSWORD=local-development-password
POSTGRES_PORT=5432
OPENFGA_PORT=8081
ZITADEL_PORT=8080

# Zitadel requires exactly 32 bytes. Use ASCII characters for this local-only value.
ZITADEL_MASTERKEY=local-development-master-key-000
ZITADEL_FIRSTINSTANCE_ORG_NAME=Auth Learning
ZITADEL_FIRSTINSTANCE_ADMIN_USERNAME=admin
ZITADEL_FIRSTINSTANCE_ADMIN_PASSWORD=LocalDevAdminPassword1!

# Apps (used in later phases)
DATABASE_URL=postgresql://app:local-development-password@localhost:5432/app
OPENFGA_API_URL=http://localhost:8081
OPENFGA_STORE_ID=
OPENFGA_AUTHORIZATION_MODEL_ID=
ZITADEL_ISSUER=http://localhost:8080
WEB_ORIGIN=http://localhost:5173
API_PORT=3000

# Used only by the bootstrap script in a later phase. Never commit a real value.
ZITADEL_BOOTSTRAP_ADMIN_TOKEN=
